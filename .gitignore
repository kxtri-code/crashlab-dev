node_modules/
dist/

# Reports are per-run and may contain target URLs.
reports/*.json

# Build 5 rerun artifacts: per-attempt execution and anomaly reports, plus the
# screenshots a rerun captured before sensitive data entered the page.
reports/reproduction/

# Build 6 baselines are operator-authored known-good records for one local
# environment. They are the input to every later review, so a machine-specific
# one should not be committed by default. Track specific baselines explicitly.
reports/baselines/

# Build 10.4 pilot rehearsal artifacts
reports/pilot/

# Build 10.5 product demo artifacts
reports/demo/

# Review state event store
reports/review-state/

# Build 3 evidence: screenshots can show whatever was on the page.
evidence/

# Build 12B.2A local artifact blob store
.artifacts/

# Local test data may hold real test credentials. Only the committed fake
# fixture is tracked.
test-data.local.json
*.test-data.json

# Static fixtures are inputs, not output, and must stay tracked.
!tests/fixtures/*.json

.env
.env.*
!.env.example

test-results/
playwright-report/
*.log
npm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/
coverage/
scratch/
