# Dockerfile.worker — CrashLab Independent Worker Service (Build 12D.2B)
#
# Packages the CrashLab queue worker as a standalone, deployable service
# separated completely from the Product API web server.
#
# Multi-stage build:
# - Stage 1 (builder): Installs all dependencies (including typescript) and compiles TypeScript to dist/
# - Stage 2 (runtime): Installs only production dependencies, downloads Chromium, and runs worker

# -----------------------------------------------------------------------------
# 1. Builder Stage
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Copy package manifests and TypeScript configuration
COPY package*.json tsconfig*.json ./

# Install ALL dependencies (including TypeScript compiler and types)
RUN npm ci

# Copy application source code
COPY src/ ./src/

# Compile TypeScript to JavaScript distribution (dist/)
RUN npm run build

# -----------------------------------------------------------------------------
# 2. Runtime Stage
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim

# Install system dependencies required for headless Chromium and health probes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Ensure writable temporary directories for Playwright and Chromium caches
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright \
    NODE_ENV=production \
    PRODUCT_WORKER_HEALTH_PORT=3230

# Prepare cache directories for non-root node user
RUN mkdir -p /home/node/.cache/ms-playwright && chown -R node:node /home/node

# Copy package manifests and install ONLY production dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy compiled distribution from builder stage
COPY --from=builder /app/dist ./dist

# Install Chromium as node user
USER node
RUN npx playwright install chromium

# Internal health probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3230/health || exit 1

# Expose internal health and readiness port
EXPOSE 3230

# Dedicated worker entry point
CMD ["node", "dist/product/worker/main.js"]
