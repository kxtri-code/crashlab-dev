# Dockerfile.api — CrashLab Product API & Dashboard Service (Build 12E)
#
# Packages the CrashLab Product API and Dashboard as a standalone, production-ready
# web service for Render.
#
# Multi-stage build:
# - Stage 1 (builder): Installs all dependencies (including typescript) and compiles TypeScript to dist/
# - Stage 2 (runtime): Installs only production dependencies and runs compiled JavaScript

# -----------------------------------------------------------------------------
# 1. Builder Stage
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Copy package manifests and TypeScript configuration
COPY package*.json tsconfig*.json ./

# Install ALL dependencies (including TypeScript compiler and types)
RUN npm ci

# Copy application source code
COPY src/ ./src/

# Compile TypeScript to JavaScript distribution (dist/)
RUN npm run build

# -----------------------------------------------------------------------------
# 2. Runtime Stage
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim

# Install system dependencies required for health checks and headless Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Configure production environment defaults & Playwright browser cache
ENV NODE_ENV=production \
    PORT=3220 \
    HOST=0.0.0.0 \
    PRODUCT_WORKER_ENABLED=false \
    PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright

# Prepare cache directories for non-root node user
RUN mkdir -p /home/node/.cache/ms-playwright && chown -R node:node /home/node

# Copy package manifests and install ONLY production dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy compiled distribution from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/product/dashboard/styles.css ./dist/product/dashboard/styles.css

# Switch to non-root user and install Chromium
USER node
RUN npx playwright install chromium

# Health check probe against local port
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3220}/health || exit 1

# Expose HTTP port
EXPOSE 3220

# Run compiled production API server
CMD ["node", "dist/product/api/main.js"]
