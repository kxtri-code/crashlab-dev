# Dockerfile.api — CrashLab Product API & Dashboard Service (Build 12E)
#
# Packages the CrashLab Product API and Dashboard as a standalone, production-ready
# web service for Render.
#
# Multi-stage build:
# - Stage 1 (builder): Installs all dependencies (including typescript) and compiles TypeScript to dist/
# - Stage 2 (runtime): Installs only production dependencies and runs compiled JavaScript

# -----------------------------------------------------------------------------
# 1. Builder Stage
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Copy package manifests and TypeScript configuration
COPY package*.json tsconfig*.json ./

# Install ALL dependencies (including TypeScript compiler and types)
RUN npm ci

# Copy application source code
COPY src/ ./src/

# Compile TypeScript to JavaScript distribution (dist/)
RUN npm run build

# -----------------------------------------------------------------------------
# 2. Runtime Stage
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim

# Install system dependencies required for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Configure production environment defaults
ENV NODE_ENV=production \
    PORT=3220 \
    HOST=0.0.0.0 \
    PRODUCT_WORKER_ENABLED=false

# Copy package manifests and install ONLY production dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy compiled distribution from builder stage
COPY --from=builder /app/dist ./dist

# Switch to non-root user
USER node

# Health check probe against local port
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3220}/health || exit 1

# Expose HTTP port
EXPOSE 3220

# Run compiled production API server
CMD ["node", "dist/product/api/main.js"]
