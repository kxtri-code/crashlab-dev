# CrashLab configuration
#
# Node 20.6+ can load this file natively:
#   npm run scout:env -- scout https://staging.example.com
# Copy to `.env` and edit. `.env` is gitignored - never commit real values.
#
# Precedence: CLI flag > environment variable > built-in default.

# Run Chromium with a visible window (default: true, i.e. headless).
CRASHLAB_HEADLESS=false

# Navigation timeout in milliseconds (default: 30000).
CRASHLAB_TIMEOUT_MS=30000

# Extra settle time in milliseconds after load, for late-rendering content (default: 1000).
CRASHLAB_SETTLE_MS=1000

# Where the JSON report is written (default: reports/scout.json).
CRASHLAB_OUTPUT=reports/scout.json

# Slow down every Playwright action, in milliseconds. Useful for watching a run (default: 0).
CRASHLAB_SLOW_MO_MS=0

# Accept invalid TLS certificates. Intended for local/staging apps with self-signed certs.
CRASHLAB_INSECURE=false

# Viewport used for the session, as WIDTHxHEIGHT (default: 1280x800).
CRASHLAB_VIEWPORT=1280x800

# --- Build 2: Journey Intelligence ---------------------------------------

# Where `npm run journey` writes its plan (default: reports/journey.json).
CRASHLAB_JOURNEY_OUTPUT=reports/journey.json

# --- Build 3: Journey Executor -------------------------------------------

# Which journey plan `npm run execute` reads by default (default: reports/journey.json).
CRASHLAB_JOURNEY_INPUT=reports/journey.json

# Where `npm run execute` writes its report (default: reports/execution.json).
CRASHLAB_EXECUTION_OUTPUT=reports/execution.json

# Directory an upload step's test fixture must live inside (default: tests/fixtures).
# Uploads outside this root are refused.
CRASHLAB_FIXTURE_ROOT=./tests/fixtures

# Safe test mode is always on and has no environment variable: a live payment
# path cannot be enabled, so there is nothing to configure here.

# --- Build 4: Anomaly Engine ---------------------------------------------

# Which execution report `npm run anomalies` reads by default.
CRASHLAB_EXECUTION_INPUT=reports/execution.json

# Where `npm run anomalies` writes its report (default: reports/anomalies.json).
CRASHLAB_ANOMALY_OUTPUT=reports/anomalies.json

# Console warnings are excluded by default, because a warning is frequently
# expected. Use --include-console-warnings to include them for a single run.

# --- Build 5: Controlled Reproducer ---------------------------------------

# Which anomaly report `npm run reproduce` reads by default.
CRASHLAB_ANOMALY_INPUT=reports/anomalies.json

# Where `npm run reproduce` writes its report (default: reports/reproduction.json).
CRASHLAB_REPRODUCTION_OUTPUT=reports/reproduction.json

# Attempt count is a flag, not an environment variable, so that a run's
# reproduction budget is always visible in the command that performed it.
# Default 3, minimum 1, maximum 5. Out-of-range values are rejected, not clamped.

# --- Build 5.1: Environment Provenance -------------------------------------
#
# Environment identity is a flag, not an environment variable, for the same
# reason: the identity a run claims must be visible in the command that ran it.
#
#   --environment-id <id>   short safe id, e.g. local-shop
#   --app-build-id <id>     short safe build id, e.g. build-001
#   --data-id <id>          short safe fixture id, e.g. fake-login-v1
#   --hash-test-data        opt in to a SHA-256 of the fixture file
#
# An unsafe value (a path, URL, or credential) is rejected, not trimmed.
# Hashing is opt-in because a hash marks identity, it does not protect a secret.

# --- Build 6: Baseline and Candidate Review -------------------------------
#
# Baseline identity is a flag, not an environment variable, so the claim a
# baseline makes is visible in the command that made it.
#
#   --baseline-id <id>      the id, and therefore the file name
#   --confirm-known-good    REQUIRED; a baseline is never inferred
#   --accept-signal <id>    accept a known signal instead of fixing it
#   --no-reproduction       review without a reproduction report
#
# Storage is a directory of JSON files under reports/baselines/. There is no
# database, and no dashboard.
#
#   --baseline-id <id>            the id, and therefore the file name
#   --confirm-known-good          REQUIRED; a baseline is never inferred
#   --allow-unverified-assertions permit a run that left prose assertions
#                                 unverified. Requires --confirm-known-good,
#                                 records known-good-partial, and never
#                                 overrides a failed or blocked run.

# --- Build 12A: PostgreSQL / Supabase Persistence Adapter -------------------
#
# Connection string for PostgreSQL or Supabase database (placeholder only).
# Local tests and in-memory adapter run without this variable.
DATABASE_URL=postgresql://user:password@localhost:5432/crashlab

# Optional connection pool and TLS settings
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# --- Build 12B.1: Product Authentication & Storage Provider ------------------
#
# Authentication mode: 'development' (permits X-User-Id header fallback)
#                      'production'  (strictly requires Bearer token)
PRODUCT_AUTH_MODE=development

# Secret key used for signing and verifying HMAC-SHA256 bearer tokens.
# Placeholder only - replace with a cryptographically secure random string in local .env.
PRODUCT_AUTH_SECRET=local-dev-placeholder-secret-change-in-env

# Storage provider: 'in-memory' (transient, test-safe)
#                   'postgres'   (requires DATABASE_URL)
PRODUCT_STORAGE=in-memory

# --- Build 12B.2A: Secure Artifact Blob Storage ------------------------------
#
# Physical artifact storage provider: 'local' (filesystem, test/dev default)
#                                     's3'    (S3-compatible object store)
PRODUCT_BLOB_STORE=local

# Safe local directory where artifact blobs are physically stored.
# Must be an explicit path; paths traversing outside this root are rejected.
PRODUCT_BLOB_ROOT=./.artifacts

# Optional S3-compatible configuration (when PRODUCT_BLOB_STORE=s3)
# PRODUCT_BLOB_S3_BUCKET=crashlab-evidence-vault
# PRODUCT_BLOB_S3_PREFIX=artifacts/

# --- Build 12B.2B: PostgreSQL-Backed Asynchronous Run Queue -----------------
#
# Worker loop enabled flag (disabled by default):
PRODUCT_WORKER_ENABLED=false

# Worker instance identifier (alphanumeric, dash, dot, underscore only):
PRODUCT_WORKER_ID=worker-local-1

# Polling frequency in milliseconds (min: 100ms, default: 1000ms):
PRODUCT_WORKER_POLL_MS=1000

# Worker lease duration in seconds (min: 5s, default: 60s):
PRODUCT_WORKER_LEASE_SECONDS=60

# Max parallel jobs processed concurrently per worker instance (bounded 1-10):
PRODUCT_WORKER_MAX_CONCURRENCY=1
