{
  "name": "crashlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrashLab - usage-based autonomous software QA platform. Build 1: CLI-first Playwright scout.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "crashlab": "./dist/cli.js"
  },
  "scripts": {
    "scout": "tsx src/cli.ts",
    "scout:env": "node --env-file=.env --import tsx src/cli.ts",
    "journey": "tsx src/cli.ts journey",
    "journey:env": "node --env-file=.env --import tsx src/cli.ts journey",
    "execute": "tsx src/cli.ts execute",
    "execute:env": "node --env-file=.env --import tsx src/cli.ts execute",
    "anomalies": "tsx src/cli.ts anomalies",
    "anomalies:env": "node --env-file=.env --import tsx src/cli.ts anomalies",
    "reproduce": "tsx src/cli.ts reproduce",
    "reproduce:env": "node --env-file=.env --import tsx src/cli.ts reproduce",
    "baseline": "tsx src/cli.ts baseline",
    "review": "tsx src/cli.ts review",
    "review-state": "tsx src/cli.ts review-state",
    "review-api": "tsx src/cli.ts review-api",
    "review-ui": "tsx src/cli.ts review-ui",
    "pilot-preflight": "tsx src/cli.ts pilot-preflight",
    "pilot": "tsx src/cli.ts pilot",
    "demo": "tsx src/cli.ts demo",
    "db:check": "tsx src/cli.ts db:check",
    "db:migrate": "tsx src/cli.ts db:migrate",
    "auth:token": "tsx src/cli.ts auth:token",
    "auth:check": "tsx src/cli.ts auth:check",
    "storage:check": "tsx src/cli.ts storage:check",
    "storage:setup": "tsx src/cli.ts storage:setup",
    "storage:smoke": "tsx src/cli.ts storage:smoke",
    "worker": "tsx src/cli.ts worker",
    "dashboard": "tsx src/cli.ts dashboard",
    "setup": "playwright install chromium",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:browser": "vitest run tests/browser --fileParallelism=false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
